---
import Base from '../layouts/Base.astro';
import { load } from '../lib/site.js';
const w = load('work.yml');
---
<Base title="Open source" current="projects" description="Open-source code by Imen Al Samarai: the code behind her papers and tools she has built, free to read, run and reuse.">
  <section class="page-head">
    <p class="label">Open source</p>
    <h1 class="page-title">Code and tools</h1>
    <p class="page-intro">The code behind my papers and tools I have built, in physics, markets and AI. All of it is public on GitHub: free to read, run and reuse.</p>
  </section>

  {w.projects?.length > 0 && (
    <section class="rule" style="padding:48px 0 72px" aria-labelledby="h-r">
      <h2 id="h-r" class="sr-only">Projects</h2>
      {w.projects.map((p) => (
        <article class="project">
          <img class={`img ${p.image_fit === 'contain' ? 'contain' : ''}`} src={p.image} alt={p.image_alt || ''} loading="lazy" />
          <div class="body">
            <span class="tag">{p.label}</span>
            <h3>{p.title}</h3>
            {p.subtitle && <span class="sub">{p.subtitle}</span>}
            <p>{p.description}</p>
            <span class="mono">{p.tools}</span>
            <span class="links">{(p.links || []).map((l) => <a href={l.url}>{l.label} ↗︎</a>)}</span>
          </div>
        </article>
      ))}
    </section>
  )}

</Base>
