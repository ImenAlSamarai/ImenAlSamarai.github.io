---
import Base from '../layouts/Base.astro';
import Ridgelines from '../components/Ridgelines.astro';
import { site, load, getPublications, formatDate } from '../lib/site.js';
import { getCollection } from 'astro:content';

const h = site.home;

// Latest: published items only (drafts never appear here, even in the preview).
const FIELDS = ['Physics', 'Markets', 'AI', 'Arts'];
const pubs = getPublications().filter((p) => p.year).map((p) => ({
  field: p.field === 'Finance' ? 'Markets' : p.field, type: 'Publication', sort: Number(p.year), date: String(p.year), title: p.title, venue: p.venue, href: p.link || '/publications/',
}));
const posts = (await getCollection('writing', (e) => !e.data.draft)).filter((p) => p.data.tag !== 'Other').map((p) => ({
  field: p.data.tag, type: p.data.type, sort: p.data.date.getFullYear() + p.data.date.getMonth() * 0.083, date: formatDate(p.data.date), title: p.data.title, venue: '', summary: p.data.summary || '', href: `/writing/${p.id}/`,
}));
const art = (await getCollection('studio', (e) => !e.data.draft)).map((p) => ({
  field: 'Arts', type: p.data.kind, sort: Number(p.data.year) || 0, date: String(p.data.year || ''), title: p.data.title, venue: p.data.medium || '', href: '/studio/',
}));
const subs = (load('substack.yml') || []).map((p) => { const d = new Date(p.date); return {
  field: p.field, type: p.type || 'Note', sort: d.getFullYear() + d.getMonth() * 0.083 + d.getDate() * 0.0027, date: formatDate(d), title: p.title, venue: p.source || 'Substack', summary: p.summary || '', href: p.url,
}; });
const all = [...pubs, ...posts, ...subs, ...art].sort((a, b) => b.sort - a.sort);
const SUM = load('summaries.yml') || {};
// One item per field and type (e.g. the newest Physics publication and the newest Physics note), newest first.
const seen = new Set();
const picked = all.filter((i) => { const k = i.field + '|' + i.type; if (seen.has(k)) return false; seen.add(k); return true; }).slice(0, 6);
const latest = picked.map((i) => ({ ...i, summary: i.summary || SUM[i.href] || '' }));
const missing = FIELDS.filter((f) => !all.some((i) => i.field === f));
const cols = FIELDS.map((f) => ({ field: f, items: all.filter((i) => i.field === f).slice(0, 2) }));
const EMPTY = {
  Physics: { text: 'Publications', href: '/publications/' },
  Markets: { text: 'Notes and essays on markets are coming soon.', href: '/writing/', label: 'Writing →' },
  AI: { text: 'More AI work is coming soon.', href: '/projects/', label: 'Projects →' },
  Arts: { text: 'Music and visual work are coming soon.', href: '/studio/', label: 'Enter the studio ↗︎' },
};
const MORE = { Physics: ['/publications/', 'All publications'], Markets: ['/writing/', 'Writing'], AI: ['/publications/', 'All publications'], Arts: ['/studio/', 'Studio'] };
---
<Base>
  <section class="landing">
    <div class="landing-text">
      <div class="landing-id">
        <img src="/images/portrait.jpg" alt={`Portrait of ${site.name}`} width="112" height="112" />
        <p class="label fields">{site.fields.split(' · ').map((f, i) => <span>{i > 0 && '· '}{f}{' '}</span>)}</p>
      </div>
      <div class="name-block">
        <h1>Imen<br />Al Samarai</h1>
        <p class="role">{h.role}</p>
      </div>
      <p class="welcome">{h.welcome}</p>
      <p class="pontus-cta"><a class="link-accent" href={h.pontus_link}>{h.pontus_cta} ↗︎</a></p>
      <div class="contact-actions">
        <a class="btn btn-solid save" href="/imen-al-samarai.vcf" download>Save my contact</a>
        {site.links.linkedin && <a class="btn" href={site.links.linkedin}>LinkedIn</a>}
        <a class="btn" href="#" data-email data-u={site.email_user} data-d={site.email_domain}>Email</a>
      </div>
    </div>
    <div class="landing-art"><Ridgelines /></div>
  </section>

  <section class="mid" aria-labelledby="h-latest">
    <h2 id="h-latest" class="label">Latest</h2>
    <div class="latest">
      {latest.map((i) => (
        <a class={`lt${i.type === 'Publication' ? ' lt-pub' : ''}`} href={i.href}>
          <span class="lt-meta"><span class={`kind kind-${i.type.toLowerCase()}`}>{i.type}</span><span class="tag">{i.field}</span><span class="m">{i.date}{i.venue && ` · ${i.venue}`}</span></span>
          <span class="lt-t">{i.title}</span>
          {i.summary && <span class="lt-s">{i.summary}</span>}
        </a>
      ))}
      {missing.length > 0 && (
        <p class="lt-soon">
          <span class="m">Coming soon</span>
          {missing.map((f) => <a href={EMPTY[f].href}>{f === 'Arts' ? 'Arts: music and visual work' : f === 'Markets' ? 'Markets: notes and essays' : f}</a>)}
        </p>
      )}
    </div>
    <p class="lt-more"><a class="link-accent" href="/publications/">All publications →</a><a class="link-accent" href="/writing/">All writing →</a></p>
  </section>
</Base>
