---
import Base from '../layouts/Base.astro';
import Ridgelines from '../components/Ridgelines.astro';
import { site, load, getPosts, formatDate } from '../lib/site.js';

const selected = load('selected.yml') || [];
const work = load('work.yml');
const posts = await getPosts();
const venture = work.ventures?.[0];
const items = [
  ...selected.slice(0, 2).map((p) => ({ tag: p.field === 'AI' ? 'AI research' : p.field, title: p.title, meta: `${p.venue} · ${p.year}`, href: p.link })),
  ...(venture ? [{ tag: 'Venture', title: venture.name, meta: venture.description, href: '/work/' }] : []),
  ...(posts[0] ? [{ tag: 'Latest writing', title: posts[0].data.title, meta: `${formatDate(posts[0].data.date)} · ${posts[0].data.tag}`, href: `/writing/${posts[0].id}/` }] : []),
];
---
<Base>
  <section class="landing">
    <div class="landing-text">
      <div class="landing-id">
        <img src="/images/portrait.jpg" alt={`Portrait of ${site.name}`} width="112" height="112" />
        <p class="label">{site.fields}</p>
      </div>
      <h1>Imen<br />Al Samarai</h1>
      <p class="tagline">{site.home.tagline}</p>
      <div class="contact-actions">
        <a class="btn btn-solid save" href="/imen-al-samarai.vcf" download>Save my contact</a>
        {site.links.linkedin && <a class="btn" href={site.links.linkedin}>LinkedIn</a>}
        <a class="btn" href="#" data-email data-u={site.email_user} data-d={site.email_domain}>Email</a>
      </div>
    </div>
    <div class="landing-art"><Ridgelines /></div>
  </section>

  <section class="selected-strip" aria-labelledby="h-sel">
    <h2 id="h-sel" class="label">Selected</h2>
    <div class="strip">
      {items.map((it) => (
        <a class="mini" href={it.href}>
          <span class="tag">{it.tag}</span>
          <span class="t">{it.title}</span>
          <span class="m">{it.meta}</span>
        </a>
      ))}
    </div>
    <p class="strip-links">
      <a class="link-accent" href="/research/">All research →</a>
      {posts.length > 0 && <a class="link-accent" href="/writing/">All writing →</a>}
      <a class="link-accent" href="/work/">All work →</a>
      <a class="link-accent" href="/about/">More about me →</a>
    </p>
  </section>
</Base>
