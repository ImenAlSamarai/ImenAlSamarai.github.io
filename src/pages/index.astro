---
import Base from '../layouts/Base.astro';
import Ridgelines from '../components/Ridgelines.astro';
import { site, getPosts, getDrawings, formatDate } from '../lib/site.js';

const posts = await getPosts();
const drawings = await getDrawings();
const preview = process.env.INCLUDE_DRAFTS === '1';
const choice = 'A';
const now = site.home.now;
const threads = site.home.threads;
// Option B: newest items of any kind (papers, projects, essays).
const latest = [
  ...posts.filter((p) => !p.data.draft).slice(0, 2).map((p) => ({ date: formatDate(p.data.date), type: 'Essay', title: p.data.title, href: `/writing/${p.id}/` })),
  { date: '2026', type: 'AI research', title: 'Verifying Decisions Under Uncertainty', href: now.research_link },
  { date: '2026', type: 'Project', title: 'AI research intelligence platform', href: '/projects/' },
  { date: '2021', type: 'Physics', title: 'The SST-1M project for the Cherenkov Telescope Array', href: '/publications/' },
].slice(0, 4);
---
<Base>
  <section class="landing">
    <div class="landing-text">
      <div class="landing-id">
        <img src="/images/portrait.jpg" alt={`Portrait of ${site.name}`} width="112" height="112" />
        <p class="label fields">{site.fields.split(' · ').map((f, i) => <span>{i > 0 && '· '}{f}{' '}</span>)}</p>
      </div>
      <h1>Imen<br />Al Samarai</h1>
      <p class="welcome">{site.home.welcome}</p>
      <div class="contact-actions">
        <a class="btn btn-solid save" href="/imen-al-samarai.vcf" download>Save my contact</a>
        {site.links.linkedin && <a class="btn" href={site.links.linkedin}>LinkedIn</a>}
        <a class="btn" href="#" data-email data-u={site.email_user} data-d={site.email_domain}>Email</a>
      </div>
    </div>
    <div class="landing-art"><Ridgelines /></div>
  </section>

  {/* Preview builds show all three options with a switch; the live site shows the chosen one. */}
  {preview && (
    <div class="opt-switch" role="group" aria-label="Preview: landing option">
      <span class="label">Preview · middle of the page</span>
      <button type="button" data-opt="A" aria-pressed="true">A · Now + three fields</button>
      <button type="button" data-opt="B" aria-pressed="false">B · Now + latest</button>
      <button type="button" data-opt="C" aria-pressed="false">C · Minimal</button>
    </div>
  )}

  {(preview || choice === 'A') && (
    <section class="mid" data-opt-view="A" aria-label="What I do now">
      <a class="now-card" href={now.link}>
        <span class="label">Now</span>
        <span class="now-t">{now.title}</span>
        <span class="now-d">{now.text}</span>
        <span class="link-accent">{now.link_label}</span>
      </a>
      <div class="threads">
        {threads.map((t) => (
          <article class="thread">
            <span class="tag">{t.field}</span>
            <p class="proof">{t.proof}</p>
            <span class="m">{t.meta}</span>
            <span class="thread-links"><a class="link-accent" href={t.link}>{t.link_label}</a><a href={t.more}>{t.more_label} →</a></span>
          </article>
        ))}
      </div>
    </section>
  )}

  {(preview || choice === 'B') && (
    <section class="mid" data-opt-view="B" hidden={preview ? true : undefined} aria-label="What I do now">
      <a class="now-card" href={now.link}>
        <span class="label">Now</span>
        <span class="now-t">{now.title}</span>
        <span class="now-d">{now.text}</span>
        <span class="link-accent">{now.link_label}</span>
      </a>
      <h2 class="label" style="margin:40px 0 8px">Latest</h2>
      <div class="latest">
        {latest.map((it) => (
          <a class="latest-row" href={it.href}>
            <span class="m">{it.date}</span>
            <span class="tag">{it.type}</span>
            <span class="t">{it.title}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {(preview || choice === 'C') && (
    <section class="mid mid-c" data-opt-view="C" hidden={preview ? true : undefined} aria-label="What I do now">
      <span class="label">Now</span>
      <p class="now-big">{now.title}. {now.text} Currently researching how language models plan under uncertainty.</p>
      <span class="thread-links"><a class="link-accent" href={now.link}>{now.link_label}</a><a href={now.research_link}>Read the preprint ↗︎</a></span>
    </section>
  )}

  <section class="beyond" aria-labelledby="h-beyond">
    <h2 id="h-beyond" class="label">Beyond research</h2>
    <div class="beyond-grid">
      <a class="beyond-card" href="/writing/">
        <span class="tag">Writing</span>
        <span class="t">Essays and notes</span>
        <span class="d">{site.home.writing_line}</span>
        {posts.length > 0
          ? <><span class="m">Latest: {posts[0].data.title}</span><span class="link-accent">Read →</span></>
          : <span class="soon">Coming soon</span>}
      </a>
      <a class="beyond-card studio-card" href="/studio/">
        <span class="tag">Studio</span>
        <span class="t">{site.home.studio_title}</span>
        {drawings.length === 0 && <span class="soon">Coming soon</span>}
        <span class="go">Enter the studio ↗︎</span>
      </a>
    </div>
  </section>
  {preview && (
    <script is:inline>
      document.querySelectorAll('[data-opt]').forEach(function (b) {
        b.addEventListener('click', function () {
          document.querySelectorAll('[data-opt]').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
          document.querySelectorAll('[data-opt-view]').forEach(function (v) { v.hidden = v.dataset.optView !== b.dataset.opt; });
        });
      });
    </script>
  )}
</Base>
