---
import Base from '../layouts/Base.astro';
import Ridgelines from '../components/Ridgelines.astro';
import { site, load, getPosts, getDrawings, formatDate } from '../lib/site.js';

const posts = await getPosts();
const drawings = await getDrawings();
const preview = process.env.INCLUDE_DRAFTS === '1';
const choice = 'A';
const cur = site.home.currently;
const fw = site.home.fields_work;
// Option B: projects with an image, newest first.
const feat = (load('work.yml').projects || []).filter((p) => p.image).slice(0, 3).map((p) => {
  const main = (p.links || []).find((l) => /code/i.test(l.label)) || (p.links || [])[0];
  return { ...p, href: main ? main.url : '/projects/', cta: main ? `${main.label} ↗︎` : 'More →' };
});
---
<Base>
  <section class="landing">
    <div class="landing-text">
      <div class="landing-id">
        <img src="/images/portrait.jpg" alt={`Portrait of ${site.name}`} width="112" height="112" />
        <p class="label fields">{site.fields.split(' · ').map((f, i) => <span>{i > 0 && '· '}{f}{' '}</span>)}</p>
      </div>
      <h1>Imen<br />Al Samarai</h1>
      <p class="welcome">{site.home.welcome}</p>
      <div class="contact-actions">
        <a class="btn btn-solid save" href="/imen-al-samarai.vcf" download>Save my contact</a>
        {site.links.linkedin && <a class="btn" href={site.links.linkedin}>LinkedIn</a>}
        <a class="btn" href="#" data-email data-u={site.email_user} data-d={site.email_domain}>Email</a>
      </div>
    </div>
    <div class="landing-art"><Ridgelines /></div>
  </section>

  {/* Preview builds show all three options with a switch; the live site shows the chosen one. */}
  {preview && (
    <div class="opt-switch" role="group" aria-label="Preview: landing option">
      <span class="label">Preview · middle of the page</span>
      <button type="button" data-opt="A" aria-pressed="true">A · Currently + one piece per field</button>
      <button type="button" data-opt="B" aria-pressed="false">B · Featured work (images)</button>
      <button type="button" data-opt="C" aria-pressed="false">C · Questions</button>
    </div>
  )}

  {(preview || choice === 'A') && (
    <section class="mid" data-opt-view="A" aria-label="Current work">
      <div class="now-card">
        <span class="label">Currently</span>
        <p class="now-big">{cur.text}</p>
        <a class="link-accent" href={cur.link}>{cur.link_label}</a>
      </div>
      <div class="threads">
        {fw.map((t) => (
          <article class="thread">
            <span class="tag">{t.field}</span>
            <a class="proof" href={t.link}>{t.title}</a>
            <span class="m">{t.meta}</span>
            <span class="thread-links"><a class="link-accent" href={t.link}>{t.link_label}</a><a href={t.more}>{t.more_label} →</a></span>
          </article>
        ))}
      </div>
      <p class="pontus-line">{site.home.pontus_line} <a class="link-accent" href={site.home.pontus_link}>pontus-analytics.com ↗︎</a></p>
    </section>
  )}

  {(preview || choice === 'B') && (
    <section class="mid" data-opt-view="B" hidden={preview ? true : undefined} aria-label="Featured work">
      <div class="mid-head">
        <h2 class="label">Featured work</h2>
        <a class="link-accent" href="/projects/">All projects →</a>
      </div>
      <div class="feat">
        {feat.map((p) => (
          <a class="feat-card" href={p.href}>
            <img src={p.image} alt={p.image_alt || ''} loading="lazy" class={p.image_fit === 'contain' ? 'contain' : ''} />
            <span class="tag">{p.label}</span>
            <span class="t">{p.title}</span>
            <span class="link-accent">{p.cta}</span>
          </a>
        ))}
      </div>
      <p class="pontus-line">{cur.text} <a class="link-accent" href={cur.link}>{cur.link_label}</a></p>
      <p class="pontus-line">{site.home.pontus_line} <a class="link-accent" href={site.home.pontus_link}>pontus-analytics.com ↗︎</a></p>
    </section>
  )}

  {(preview || choice === 'C') && (
    <section class="mid" data-opt-view="C" hidden={preview ? true : undefined} aria-label="Questions I work on">
      <h2 class="label">Questions I work on</h2>
      <div class="qs">
        {fw.map((t) => (
          <a class="q-row" href={t.link}>
            <span class="tag">{t.field}</span>
            <span class="q">{t.question}</span>
            <span class="m">{t.title} · {t.meta}</span>
          </a>
        ))}
      </div>
      <p class="pontus-line">{site.home.pontus_line} <a class="link-accent" href={site.home.pontus_link}>pontus-analytics.com ↗︎</a></p>
    </section>
  )}

  <section class="beyond" aria-labelledby="h-beyond">
    <h2 id="h-beyond" class="label">Beyond research</h2>
    <div class="beyond-grid">
      <a class="beyond-card" href="/writing/">
        <span class="tag">Writing</span>
        <span class="t">Essays and notes</span>
        <span class="d">{site.home.writing_line}</span>
        {posts.length > 0
          ? <><span class="m">Latest: {posts[0].data.title}</span><span class="link-accent">Read →</span></>
          : <span class="soon">Coming soon</span>}
      </a>
      <a class="beyond-card studio-card" href="/studio/">
        <span class="tag">Studio</span>
        <span class="t">{site.home.studio_title}</span>
        {drawings.length === 0 && <span class="soon">Coming soon</span>}
        <span class="go">Enter the studio ↗︎</span>
      </a>
    </div>
  </section>
  {preview && (
    <script is:inline>
      document.querySelectorAll('[data-opt]').forEach(function (b) {
        b.addEventListener('click', function () {
          document.querySelectorAll('[data-opt]').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
          document.querySelectorAll('[data-opt-view]').forEach(function (v) { v.hidden = v.dataset.optView !== b.dataset.opt; });
        });
      });
    </script>
  )}
</Base>
