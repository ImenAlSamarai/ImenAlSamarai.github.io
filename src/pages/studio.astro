---
import Base from '../layouts/Base.astro';
import { site, getDrawings } from '../lib/site.js';
const drawings = await getDrawings();
---
<Base title="Studio" bare description={`${site.name} — Studio: drawing, painting and digital art.`}>
  <div class="studio">
    <div class="wrap" style="max-width:1200px">
      <header class="s-head">
        <a href="/" class="s-back">← {site.name}</a>
        <nav aria-label="Studio" class="s-nav"><a href="#drawings" aria-current="page">Drawings</a></nav>
      </header>
      <section class="s-hero">
        <p class="s-kicker">Welcome to my</p>
        <h1>Studio</h1>
        <p class="s-intro">{site.studio.intro}</p>
        <a href="#drawings" class="s-down" aria-label="Enter the studio">↓</a>
      </section>
      <main id="main">
        <section id="drawings" class="s-section" aria-labelledby="h-dr">
          <div class="s-row"><h2 id="h-dr">Drawings</h2><span class="s-meta">{drawings.length} {drawings.length === 1 ? 'work' : 'works'}</span></div>
          <div class="s-grid">
            {drawings.map((d) => (
              <figure>
                <a href={d.data.image}><img src={d.data.image} alt={d.data.title} loading="lazy" /></a>
                <figcaption><span class="s-title">{d.data.title}</span><span class="s-meta">{[d.data.year, d.data.medium].filter(Boolean).join(' · ')}</span></figcaption>
              </figure>
            ))}
          </div>
        </section>
      </main>
      <footer class="s-foot"><a href="/">← Back to the main site</a><span>{site.name} · Studio</span></footer>
    </div>
  </div>
</Base>
<style is:global>
  .studio { background: #141413; color: #EDEBE6; min-height: 100vh; }
  .studio a { color: #EDEBE6; } .studio a:hover { color: #D9C9A8; }
  .s-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; padding: 28px 0; }
  .s-back { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; color: #B9B6AE !important; }
  .s-nav a { font-family: var(--serif); font-style: italic; font-size: 19px; color: #D9C9A8 !important; }
  .s-hero { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 28px; padding: 140px 0 160px; }
  .s-kicker { margin: 0; font-family: var(--mono); font-size: 12px; letter-spacing: 0.24em; text-transform: uppercase; color: #A29F96; }
  .s-hero h1 { margin: 0; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(80px, 14vw, 200px); line-height: 0.9; letter-spacing: -0.03em; }
  .s-intro { margin: 0; max-width: 520px; font-family: var(--serif); font-weight: 300; font-size: 22px; line-height: 1.5; color: #CFCCC4; }
  .s-down { margin-top: 24px; display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border: 1px solid #4A4844; border-radius: 50%; font-size: 18px; }
  .s-section { padding: 72px 0 120px; border-top: 1px solid #2E2D2A; }
  .s-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 48px; }
  .s-row h2 { margin: 0; font-family: var(--serif); font-weight: 300; font-size: 48px; }
  .s-meta { font-family: var(--mono); font-size: 12px; color: #A29F96; }
  .s-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 56px 40px; align-items: start; }
  .s-grid figure { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .s-grid figure:nth-child(3n+2) { padding-top: 80px; } .s-grid figure:nth-child(3n) { padding-top: 32px; }
  .s-grid img { width: 100%; height: auto; border: 1px solid #2E2D2A; background: #1F1E1C; }
  .s-grid figcaption { display: flex; justify-content: space-between; gap: 16px; }
  .s-title { font-family: var(--serif); font-style: italic; font-size: 19px; }
  .s-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; padding: 40px 0 56px; border-top: 1px solid #2E2D2A; font-size: 15px; color: #B9B6AE; }
  @media (max-width: 640px) { .s-hero { padding: 72px 0 96px; } .s-grid figure:nth-child(n) { padding-top: 0; } }
</style>
