---
import Base from '../layouts/Base.astro';
import PathSky from '../components/PathSky.astro';
import { site, load } from '../lib/site.js';
const cv = load('cv.yml');
const a = site.about;
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];
---
<Base title="About" current="about">
  <section class="about-hero">
    <img src="/images/portrait.jpg" alt={`Portrait of ${site.name}`} width="720" height="900" />
    <div class="txt">
      <p class="label">About</p>
      <h1 class="about-name">Dr. {site.name}</h1>
      {a.intro.split(/\n\s*\n/).map((para) => <p style="margin:0;font-size:19px;line-height:1.65;color:var(--fg-2)">{para}</p>)}
      <p style="margin:0;font-size:19px;line-height:1.65;color:var(--fg-2)">{a.contact_line}</p>
      <div class="btn-row" style="padding-top:4px">
        <a class="btn btn-solid" href="#" data-email data-u={site.email_user} data-d={site.email_domain}>Get in touch</a>
        <a class="btn" href="/cv.pdf">Download CV</a>
        <a class="link-accent" href="/cv/" style="align-self:center">View CV online →</a>
      </div>
    </div>
  </section>

  <PathSky variant="A">
    <Fragment slot="aside">
      {a.press?.length > 0 && (
        <div>
          <h2 class="label" style="margin-bottom:16px">Press</h2>
          <div class="rows stack">
            {a.press.map((p) => <a class="item" href={p.link} style="display:flex;justify-content:space-between;font-weight:600">{p.outlet}<span class="link-accent">↗︎</span></a>)}
          </div>
        </div>
      )}
      <div>
        <h2 class="label" style="margin-bottom:16px">Languages</h2>
        <p style="margin:0;padding-top:16px;border-top:1px solid var(--line);font-size:16px">{cv.languages}</p>
      </div>
    </Fragment>
  </PathSky>


</Base>
