---
import Base from '../../layouts/Base.astro';
import Subscribe from '../../components/Subscribe.astro';
import { site, load, getPosts, formatDate, readingTime } from '../../lib/site.js';
const own = (await getPosts()).map((p) => ({ date: p.data.date, href: `/writing/${p.id}/`, title: p.data.title, summary: p.data.summary, tag: p.data.tag, meta: `${readingTime(p.body)} min read`, draft: p.data.draft, ext: false }));
const subs = (load('substack.yml') || []).map((p) => ({ date: new Date(p.date), href: p.url, title: p.title, summary: p.summary, tag: p.field, meta: `${p.source || 'Substack'} ↗︎`, draft: false, ext: true }));
const posts = [...own, ...subs].sort((a, b) => b.date - a.date);
const tags = ['All', 'AI', 'Physics', 'Markets', 'Other'];
---
<Base title="Writing" current="writing" description="Essays and notes by Imen Al Samarai on science, markets and machine learning.">
  <section class="page-head">
    <p class="label">Writing</p>
    <h1 class="page-title">Essays and notes</h1>
  </section>
  <section class="writing-layout">
    <div class="list">
      {posts.length === 0 ? (
        <div class="soon-block">
          <span class="soon">Coming soon</span>
          <p>The first essays are being written. Topics: AI, physics, markets — and other things that catch my curiosity.</p>
          <div class="soon-lines" aria-hidden="true"><span></span><span></span><span></span></div>
        </div>
      ) : <>
      <div class="chips" role="group" aria-label="Filter by topic" style="padding-bottom:24px" data-filters>
        {tags.map((t, i) => <button class="chip" type="button" data-tag={t} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>)}
      </div>
      {posts.map((p) => (
        <a class="post-card" href={p.href} data-post data-tag={p.tag} {...(p.ext ? { rel: 'noopener' } : {})}>
          <span class="mono" style="display:flex;gap:16px"><span>{formatDate(p.date)}</span><span>{p.meta}</span>{p.draft && <span>Draft</span>}</span>
          <span class="t">{p.title}</span>
          {p.summary && <span class="s">{p.summary}</span>}
          <span class="tag">{p.tag}</span>
        </a>
      ))}
      <p class="empty" data-empty hidden>No articles in this topic yet.</p>
      </>}
    </div>
    <aside>
      {site.newsletter_form_action && <>
        <h2 style="margin:0;font-family:var(--serif);font-weight:400;font-size:24px">New articles by email</h2>
        <p class="muted" style="margin:0;font-size:16px">No more than one email per article.</p>
        <Subscribe id="w-sub" />
      </>}
      <a class="link-accent" href="/rss.xml">RSS feed</a>
    </aside>
  </section>
</Base>
<script>
  const chips = [...document.querySelectorAll('[data-filters] .chip')];
  const posts = [...document.querySelectorAll('[data-post]')];
  const empty = document.querySelector('[data-empty]');
  chips.forEach((c) => c.addEventListener('click', () => {
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    let n = 0;
    posts.forEach((p) => { const on = c.dataset.tag === 'All' || p.dataset.tag === c.dataset.tag; p.hidden = !on; if (on) n++; });
    if (empty) empty.hidden = n > 0;
  }));
</script>
