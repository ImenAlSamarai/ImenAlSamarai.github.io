---
// Animated "signal in noise" drawing used on the homepage.
const N = 22;
const rows = Array.from({ length: N }, (_, i) => i);
---
<svg class="ridges" viewBox="0 0 480 440" aria-hidden="true" data-ridges>
  {rows.map((i) => (<>
    <path class="f" data-f={i} d="" />
    <path class={i === 10 ? 'l hi' : 'l'} data-l={i} d="" />
  </>))}
</svg>
<script>
  const svg = document.querySelector('[data-ridges]');
  if (svg) {
    const N = 22;
    let s = 7;
    const rnd = () => { s = (s * 1664525 + 1013904223) >>> 0; return s / 4294967296; };
    const ph = Array.from({ length: N * 3 }, () => rnd() * Math.PI * 2);
    const fills = [...svg.querySelectorAll('[data-f]')];
    const lines = [...svg.querySelectorAll('[data-l]')];
    const draw = (t) => {
      const x0 = 250 + 90 * Math.sin(t * 0.35);
      for (let i = 0; i < N; i++) {
        const base = 70 + i * 16;
        const amp = 70 * Math.exp(-((i - 10) ** 2) / 14) * (0.75 + 0.25 * Math.sin(t * 0.7 + i * 0.5));
        let d = '';
        for (let x = 20; x <= 460; x += 4) {
          const noise = Math.sin(x * 0.045 + ph[i * 3] + t * 0.6) * 2 + Math.sin(x * 0.1 + ph[i * 3 + 1] - t * 0.4) * 1.5 + Math.sin(x * 0.02 + ph[i * 3 + 2]) * 1.8;
          const g = amp * Math.exp(-((x - x0) ** 2) / (2 * 28 * 28));
          d += (x === 20 ? 'M' : 'L') + x + ' ' + (base - noise - g).toFixed(1);
        }
        lines[i].setAttribute('d', d);
        fills[i].setAttribute('d', d + 'L460 440L20 440Z');
      }
    };
    draw(0);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      let visible = true, last = 0, start = performance.now();
      new IntersectionObserver((e) => { visible = e[0].isIntersecting; }).observe(svg);
      const loop = (now) => {
        requestAnimationFrame(loop);
        if (!visible || document.hidden || now - last < 40) return;
        last = now;
        draw((now - start) / 1000);
      };
      requestAnimationFrame(loop);
    }
  }
</script>
