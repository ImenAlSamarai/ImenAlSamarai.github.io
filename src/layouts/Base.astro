---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { site } from '../lib/site.js';

const { title, description = site.description, current = '', bare = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: '/writing/', label: 'Writing', key: 'writing' },
  { href: '/projects/', label: 'Projects', key: 'projects' },
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/publications/', label: 'Publications', key: 'publications' },
];
const sameAs = Object.values(site.links).filter(Boolean);
const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: site.name,
  url: Astro.site?.toString(), sameAs, knowsAbout: ['Astroparticle physics', 'Quantitative finance', 'Machine learning', 'Artificial intelligence'],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={`${site.name} — Writing`} href="/rss.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og.png', Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(person)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet" />
  <script is:inline>
    try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  {site.goatcounter && <script is:inline data-goatcounter={site.goatcounter} async src="//gc.zgo.at/count.js"></script>}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {bare ? <slot /> : (
    <div class="wrap">
      <header class="site-header">
        <a class="brand" href="/">{site.name}</a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
          <a class="studio-link" href="/studio/">Studio ↗︎</a>
          <button class="theme-toggle" type="button" aria-label="Switch between light and dark mode" data-theme-toggle>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor"/></svg>
          </button>
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <span class="muted">{site.name} · {site.location}</span>
        <nav aria-label="Profiles">
          <a href="#" data-email data-u={site.email_user} data-d={site.email_domain}>Email</a>
          {site.links.scholar && <a href={site.links.scholar}>Google Scholar</a>}
          {site.links.orcid && <a href={site.links.orcid}>ORCID</a>}
          {site.links.github && <a href={site.links.github}>GitHub</a>}
          {site.links.linkedin && <a href={site.links.linkedin}>LinkedIn</a>}
        </nav>
      </footer>
    </div>
  )}
  <dialog class="contact" data-contact aria-labelledby="contact-title">
    <form method="dialog" class="contact-close"><button class="theme-toggle" aria-label="Close">✕</button></form>
    <p class="label">Contact</p>
    <h2 id="contact-title">Get in touch</h2>
    <p class="muted" style="margin:0">{site.about.contact_line}</p>
    <p class="contact-address" data-address></p>
    <div class="btn-row">
      <button class="btn btn-solid" type="button" data-copy>Copy address</button>
      <a class="btn" data-mailto href="#" target="_blank" rel="noopener">Open email app</a>
    </div>
    <p class="mono" data-copied hidden>Copied.</p>
  </dialog>
  <script is:inline>
    (function () {
      var dlg = document.querySelector('[data-contact]');
      var first = document.querySelector('[data-email]');
      if (!dlg || !first) return;
      var addr = first.dataset.u + '@' + first.dataset.d;
      dlg.querySelector('[data-address]').textContent = addr;
      dlg.querySelector('[data-mailto]').href = 'mailto:' + addr;
      dlg.querySelector('[data-copy]').addEventListener('click', function () {
        var done = function () { dlg.querySelector('[data-copied]').hidden = false; };
        if (navigator.clipboard) navigator.clipboard.writeText(addr).then(done, done); else done();
      });
      dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
      document.querySelectorAll('[data-email]').forEach(function (a) {
        a.setAttribute('role', 'button');
        a.addEventListener('click', function (e) {
          e.preventDefault();
          dlg.querySelector('[data-copied]').hidden = true;
          dlg.showModal();
        });
      });
    })();
    document.querySelectorAll('[data-theme-toggle]').forEach(function (b) {
      b.addEventListener('click', function () {
        var root = document.documentElement;
        var dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
      });
    });
  </script>
</body>
</html>
